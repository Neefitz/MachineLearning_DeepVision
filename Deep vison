        "def model_seq_buildel(hp):\n",
        "  model_seq = Sequential()\n",
        "  model_seq.add(Flatten(input_shape=(32, 32, 3)))\n",
        "  hp_unit = hp.Int(\"units\", min_value=128, max_value=1024, step=64)\n",
        "  model_seq.add(Dense(units=hp_unit, activation=\"relu\"))\n",
        "  model_seq.add(Dense(100, activation=\"softmax\"))\n",
        "  hp_learning_rate = hp.Choice(\"learning_rate\", values=[1e-2, 1e-3, 1e-4])\n",
        "  model_seq.compile(optimizer=Adam(learning_rate=hp_learning_rate), loss=\"categorical_crossentropy\", metrics=[\"accuracy\"])\n",
        "  return model_seq"
      ],
      "metadata": {

    {
      "cell_type": "code",
      "source": [
        "data_augmentation_layers = Sequential([\n",
        "    RandomFlip(\"horizontal\"),\n",
        "    RandomRotation(0.05),\n",
        "    RandomTranslation(0.1, 0.1),\n",
        "    RandomZoom(0.1),\n",
        "    GaussianNoise (0.1)\n",
        "])\n",
        "\n",
        "inputs = Input(shape=(32, 32, 3))\n",
        "\n",
        "daug = data_augmentation_layers(inputs)\n",
        "\n",
        "base_model = VGG16(weights='imagenet', include_top=False, input_tensor=daug)\n",
        "\n",
        "# --- Congelar capas hasta block4_conv3 ---\n",
        "for layer in base_model.layers:\n",
        "    if layer.name == 'block4_conv3':\n",
        "        break\n",
        "    layer.trainable = False\n",
        "    print(f\"Capa {layer.name} congelada...\")\n",
        "\n",
        "\n",
        "last = base_model.output\n",
        "x = Flatten()(last)\n",
        "x = Dense(256, activation='relu', kernel_regularizer=l2(1e-4), name='fc1_aug')(x)\n",
        "x = BatchNormalization()(x)\n",
        "x = Dropout(0.4)(x)\n",
        "x = Dense(128, activation='relu', name='fc2_aug')(x)\n",
        "x = BatchNormalization()(x)\n",
        "x = Dropout(0.3)(x)\n",
        "predictions = Dense(100, activation='softmax', name='predictions_aug')(x)\n",
        "\n",
        "model = Model(inputs=inputs, outputs=predictions)\n",
        "model.compile(optimizer=Adam(learning_rate=1e-3),\n",
        "              loss='categorical_crossentropy',\n",
        "              metrics=['accuracy'])\n",
        "\n",
        "H = model.fit(\n",
        "    x_train_vgg, y_train_vgg,\n",
        "    validation_data=(x_test_vgg, y_test_vgg),\n",
        "    batch_size=64,\n",
        "    epochs=50,\n",
        "    callbacks=[early_stop, reduce_lr]\n",
        ")\n",
        "model.summary()\n",
        "\n",

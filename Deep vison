      "cell_type": "code",
      "source": [
        "for layer in base_model.layers:\n",
        "  if layer.name == 'block_12_expand':\n",
        "    break\n",
        "  layer.trainable = False\n",
        "  print('Capa ' + layer.name + ' congelada...')\n",
        "\n",
        "\n",
        "last = base_model.layers[-1].output\n",
        "x = GlobalAveragePooling2D()(last)\n",
        "x = Dense(256, activation='relu', kernel_regularizer=l2(1e-4), name='fc1')(x)\n",
        "x = BatchNormalization()(x)\n",
        "x = Dropout(0.4)(x)\n",
        "x = Dense(128, activation='relu', name='fc2')(x)\n",
        "x = BatchNormalization()(x)\n",
        "x = Dropout(0.3)(x)\n",
        "predictions = Dense(100, activation='softmax')(x)\n",
        "\n",
        "model = Model(base_model.input, outputs=predictions)\n",
        "\n",
        "\n",
        "model.compile(optimizer=SGD(0.01), loss='categorical_crossentropy', metrics=['accuracy'])\n",
        "\n",
        "model.summary()\n",
        "H = model.fit(x_train_MV, y_train_MV,\n",
        "          validation_split=0.2,\n",
        "          batch_size=64,\n",
        "          epochs=50,\n",
        "          callbacks=[early_stop, reduce_lr])\n",
        "\n",
        "print(\"[INFO]: Evaluando el modelo...\")\n",
        "predictions = model.predict(x_test_MV, batch_size=64)\n",
        "print(classification_report(y_test_MV.argmax(axis=1), predictions.argmax(axis=1), target_names=labelNames))\n",
